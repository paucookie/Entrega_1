<section class="products-container">
    <h2>Lista de Productos</h2>
    <div class="product-list">
        {{#if products.length}}
            {{#each products}}
                <div class="product-card">
                    <h3>{{this.title}}</h3>
                    <p class="description">{{this.description}}</p>
                    <p class="details"><strong>Código:</strong> {{this.code}}</p>
                    <p class="details"><strong>Precio:</strong> ${{this.price}}</p>
                    <p class="details"><strong>Stock:</strong> {{this.quantity}} unidades</p>
                    <p class="details"><strong>Categoría:</strong> {{this.category}}</p>
                </div>
            {{/each}}
        {{else}}
            <p>No hay productos disponibles.</p>
        {{/if}}
    </div>
</section>